# App Environment
ENV=dev
PORT=8000
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slides
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slides_test

# LLM Providers (any LiteLLM model string)
LLM_MODEL_PLANNER=anthropic/claude-3-5-sonnet-20241022
LLM_MODEL_SLIDE=anthropic/claude-3-5-sonnet-20241022
LLM_MODEL_EDIT=anthropic/claude-3-5-sonnet-20241022
LLM_MODEL_VISION=anthropic/claude-3-5-sonnet-20241022
LLM_TIMEOUT_S=120
FAKE_LLM=1

# Job & Ingest Settings
JOB_CONCURRENCY=4
MAX_RESOURCE_CHARS=60000

# Provider API keys (LiteLLM picks up these as expected)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
