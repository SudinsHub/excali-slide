# App Environment
ENV=dev
PORT=8000
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slides
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slides_test

# LLM Providers (for later passes)
LLM_MODEL_PLANNER=gemini-2.0-flash
LLM_MODEL_SLIDE=gemini-2.0-flash
LLM_MODEL_EDIT=gemini-2.0-flash
LLM_MODEL_VISION=gemini-2.0-flash
